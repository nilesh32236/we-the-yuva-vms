# Server
NODE_ENV=development
PORT=4000

# Database — Local PostgreSQL
# Install: sudo pacman -S postgresql
# Setup:   sudo -u postgres psql -c "CREATE USER vms_user WITH PASSWORD 'vms_password';"
#          sudo -u postgres psql -c "CREATE DATABASE vms_dev OWNER vms_user;"
DATABASE_URL=postgresql://vms_user:vms_password@localhost:5432/vms_dev?connection_limit=5&pool_timeout=10

# Redis — Local Valkey/Redis (runs on port 6379 by default)
# Check: redis-cli ping  →  should return PONG
REDIS_URL=redis://127.0.0.1:6379

# JWT — generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-in-production-min-32-chars-long!!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email Provider — 'smtp' (default) or 'resend'
EMAIL_PROVIDER=smtp

# SMTP Email — Gmail (use App Password from myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=smtp@example.com
SMTP_PASS=smtp-password
SMTP_FROM=noreply@example.com

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=change-me-in-production-public-key
VAPID_PRIVATE_KEY=change-me-in-production-private-key

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# Resend (transactional email, used when EMAIL_PROVIDER=resend)
# Get API key from https://resend.com
RESEND_API_KEY=

# Uploads directory (local dev only — use S3/cloud in production)
UPLOAD_DIR=./uploads

# Sentry — get DSN from https://sentry.io
SENTRY_DSN=

# Email & OTP behavior for deployments without SMTP (e.g. Hugging Face Spaces)
#
# When SMTP/Resend is NOT configured, the backend logs the generated OTP to the
# backend console and returns it as `devOtp` in the /auth/send-otp response so
# testers can complete end-to-end auth flows without a real inbox.
# When SMTP/Resend IS configured, real emails are sent and `devOtp` is NOT
# returned — the Dev OTP fallback is strictly ignored in that case.
#
# To surface the OTP in the frontend UI, also set the frontend env var:
#   NEXT_PUBLIC_DEV_OTP=true
#
# Dev OTP (TESTING ONLY) — when true, /auth/send-otp returns the generated OTP
# as `devOtp` in the response even if SMTP/Resend IS configured, and the
# universal OTP `000000` is accepted for any email (no inbox needed). Use for
# seeded users / testing environments (e.g. Hugging Face Spaces). NEVER set true
# in production.
#   ALLOW_DEV_OTP=true
#
# NOTE: Auth rate limiting (/api/v1/auth/*) has been temporarily disabled to
# avoid locking out testers. TODO: Restore before production release.
